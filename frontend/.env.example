# Smart Bill Splitter — Frontend Environment Variables

# Backend API Base URL
# - In local development: http://localhost:8000
# - In production with Nginx / Hostinger reverse proxy: leave empty ("")
# - In production with separate backend (e.g. Render, Railway, or api.yourdomain.com):
#   VITE_API_URL=https://api.yourdomain.com
VITE_API_URL=http://localhost:8000
