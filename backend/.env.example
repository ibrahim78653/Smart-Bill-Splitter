# ==============================================================================
# Smart Bill Splitter — Backend Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Extraction (Google Gemini) - REQUIRED
# ------------------------------------------------------------------------------
# Get your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# ------------------------------------------------------------------------------
# 2. Database (MongoDB) - REQUIRED
# ------------------------------------------------------------------------------
# Local development or Docker:
# MONGODB_URI=mongodb://localhost:27017
#
# Production with MongoDB Atlas (Free Cloud M0 Cluster):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=bill_splitter

# ------------------------------------------------------------------------------
# 3. Bill Image Storage
# ------------------------------------------------------------------------------
# Directory where uploaded receipt images are temporarily saved
IMAGE_STORAGE_PATH=./uploads
# Maximum allowed file size per upload in megabytes
MAX_IMAGE_SIZE_MB=15
# Hours before temporary images are eligible for cleanup
IMAGE_TTL_HOURS=24

# ------------------------------------------------------------------------------
# 4. CORS & Security
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (e.g. your Hostinger domain)
# Examples:
#   Local: http://localhost:5173
#   Production: https://yourdomain.com,https://www.yourdomain.com
#   Permissive (Docker internal/testing): *
CORS_ORIGINS=http://localhost:5173

# ------------------------------------------------------------------------------
# 5. Logging & Diagnostics
# ------------------------------------------------------------------------------
# Levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
DEBUG=False
