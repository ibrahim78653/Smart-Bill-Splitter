# ==============================================================================
# Smart Bill Splitter — Full-Stack Docker VPS Configuration
# ==============================================================================

# Required: Google Gemini API Key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# AI Model to use
GEMINI_MODEL=gemini-flash-latest

# Allowed CORS Origins (set to * or your domain: https://yourdomain.com)
CORS_ORIGINS=*

# Logging level
LOG_LEVEL=INFO
